# ToS Monitor Environment Configuration Template
# Copy this file to .env and fill in your values

# ========================================
# Storage Configuration
# ========================================

# Storage mode: local or cloud
# Options:
#   - local: Use ./data folder for local file storage (development/testing)
#   - cloud: Use Google Cloud Storage (production)
# Default: cloud
STORAGE_MODE=local

# Google Cloud Storage bucket name (required only if STORAGE_MODE=cloud)
# Example: my-tos-monitor-bucket
# STORAGE_BUCKET=your-bucket-name

# Local storage path (used when STORAGE_MODE=local)
# Default: ./data
LOCAL_STORAGE_PATH=./data

# ========================================
# Required Configuration
# ========================================

# OpenAI API key for LLM-powered document analysis
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# OpenRouter API key (alternative to OpenAI for accessing multiple models)
# Get from: https://openrouter.ai/keys
# Leave empty if using OpenAI directly
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key

# ========================================
# Bosch LLM Farm Configuration
# ========================================
# Bosch internal LLM service using Vertex AI models
# Get credentials from Bosch internal documentation

# Authentication token for Bosch LLM Farm
# Required when using AI_PROVIDER=bosch-llm-farm
ANTHROPIC_AUTH_TOKEN=your-bosch-farm-auth-token

# Model to use (required - no default)
# Examples: claude-sonnet-4-5@20250929, gemini-1.5-pro, gemini-1.5-flash, gemini-2.0-flash
BOSCH_LLM_MODEL=claude-sonnet-4-5@20250929

# Base URL (optional, defaults to Bosch Farm endpoint)
# Default: https://aoai-farm.bosch-temp.com/api/google/v1
# BOSCH_LLM_BASE_URL=https://aoai-farm.bosch-temp.com/api/google/v1

# ========================================
# Optional Configuration
# ========================================

# AI Provider to use for document analysis
# Options: openai, openrouter, bosch-llm-farm
# Default: openai
AI_PROVIDER=openai

# OpenAI model to use for document comparison (when using OpenAI provider)
# Default: gpt-4-turbo-preview
# Options: gpt-4-turbo-preview, gpt-4, gpt-3.5-turbo
LLM_MODEL=gpt-4-turbo-preview

# OpenRouter model to use (when using OpenRouter provider)
# Default: anthropic/claude-3.5-sonnet
# Options: anthropic/claude-3.5-sonnet, openai/gpt-4, meta-llama/llama-3.1-70b-instruct, etc.
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Bosch LLM Farm model to use (when using Bosch LLM Farm provider)
# Required - no default
# Examples: claude-sonnet-4-5@20250929, gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
# BOSCH_LLM_MODEL=claude-sonnet-4-5@20250929

# Google Cloud Project ID (required for Cloud Run deployment)
# Example: my-gcp-project-123456
GOOGLE_CLOUD_PROJECT=your-project-id

# Port for local development (Cloud Run uses 8080 automatically)
# Default: 8080
PORT=8080

# Host for local development
# Default: 0.0.0.0
HOST=0.0.0.0

# ========================================
# Development Configuration
# ========================================

# Log level for debugging
# Options: DEBUG, INFO, WARNING, ERROR
# Default: INFO
LOG_LEVEL=INFO

# Enable debug mode (for development only)
# Default: false
DEBUG=false

# ========================================
# Google Cloud Authentication (required only if STORAGE_MODE=cloud)
# ========================================

# For local development with cloud storage, you can either:
# 1. Use Application Default Credentials (recommended):
#    Run: gcloud auth application-default login
#
# 2. Use a service account key file:
#    GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
#
# For Cloud Run deployment, authentication is handled automatically
# via the service account attached to the Cloud Run service
#
# Note: Not needed if using STORAGE_MODE=local

# Uncomment if using service account key file for local development:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ========================================
# Production Security (Cloud Run)
# ========================================

# For production deployments, consider:
# - Using Google Secret Manager for sensitive values
# - Configuring VPC connectors for network security
# - Setting up proper IAM roles and service accounts
# - Enabling audit logging
# - Configuring CORS for your domain only

# Example CORS origins for production (comma-separated)
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ========================================
# Monitoring and Observability
# ========================================

# Enable structured logging (JSON format for Cloud Logging)
# Default: true in production, false in development
STRUCTURED_LOGGING=true

# Application name for logging and monitoring
APP_NAME=tos-monitor

# Version for tracking deployments
APP_VERSION=1.0.0

# Environment name (development, staging, production)
ENVIRONMENT=development